def xyz_to_lammps(xyz_file, data_file, box_padding=5.0):
    atom_masses = {
        "H": 1.008,
        "C": 12.011,
        "N": 14.007,
        "O": 15.999,
        "Ar": 39.948,
        # Add more if needed
    }

    atoms = []
    elements = set()

    with open(xyz_file, 'r') as f:
        lines = f.readlines()
        natoms = int(lines[0])
        for line in lines[2:2 + natoms]:
            parts = line.split()
            elem = parts[0]
            x, y, z = map(float, parts[1:4])
            atoms.append((elem, x, y, z))
            elements.add(elem)

    elements = sorted(elements)
    elem_to_type = {elem: i + 1 for i, elem in enumerate(elements)}

    # Find bounds
    xs = [a[1] for a in atoms]
    ys = [a[2] for a in atoms]
    zs = [a[3] for a in atoms]

    xlo = min(xs) - box_padding
    xhi = max(xs) + box_padding
    ylo = min(ys) - box_padding
    yhi = max(ys) + box_padding
    zlo = min(zs) - box_padding
    zhi = max(zs) + box_padding

    with open(data_file, 'w') as f:
        f.write("LAMMPS data file generated from XYZ\n\n")
        f.write(f"{len(atoms)} atoms\n")
        f.write(f"{len(elements)} atom types\n\n")
        f.write(f"{xlo:.6f} {xhi:.6f} xlo xhi\n")
        f.write(f"{ylo:.6f} {yhi:.6f} ylo yhi\n")
        f.write(f"{zlo:.6f} {zhi:.6f} zlo zhi\n\n")

        f.write("Masses\n\n")
        for elem, idx in elem_to_type.items():
            mass = atom_masses.get(elem, 1.0)
            f.write(f"{idx} {mass:.4f}\n")

        f.write("\nAtoms\n\n")
        for i, (elem, x, y, z) in enumerate(atoms, start=1):
            f.write(f"{i} {elem_to_type[elem]} {x:.6f} {y:.6f} {z:.6f}\n")

    print(f"Converted {xyz_file} to {data_file}")

# Example usage:
xyz_to_lammps("structure.xyz", "structure.data")
